{
    "version": 2,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 20,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "debug",
        "displayName": "Debug",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/debug",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
          "JOTJSON_BUILD_TESTS": "ON",
          "JOTJSON_BUILD_EXAMPLES": "ON",
          "JOTJSON_BUILD_CLI": "ON"
        }
      },
      {
        "name": "release",
        "displayName": "Release",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/release",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
          "JOTJSON_BUILD_TESTS": "ON",
          "JOTJSON_BUILD_EXAMPLES": "ON",
          "JOTJSON_BUILD_CLI": "ON"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "debug",
        "configurePreset": "debug"
      },
      {
        "name": "release",
        "configurePreset": "release"
      }
    ],
    "testPresets": [
      {
        "name": "debug",
        "configurePreset": "debug",
        "output": {
          "outputOnFailure": true
        }
      },
      {
        "name": "release",
        "configurePreset": "release",
        "output": {
          "outputOnFailure": true
        }
      }
    ]
  }
